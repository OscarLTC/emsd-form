# Requeridas
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcionales: si se omiten se usan los valores por defecto de src/config/env.ts
VITE_APP_NAME=Formulario móvil de contingencia
VITE_SUPABASE_BUCKET=evidence
VITE_SESSION_TTL_HOURS=12
VITE_SYNC_INTERVAL_MS=30000
VITE_SYNC_MAX_ATTEMPTS=5
VITE_PHOTO_MAX_COUNT=4
VITE_PHOTO_MAX_WIDTH=1280
VITE_PHOTO_QUALITY=0.7
VITE_REQUEST_TIMEOUT_MS=20000
VITE_UPLOAD_TIMEOUT_MS=60000

# Solo para depurar un build de producción. En desarrollo los logs ya están activos.
# VITE_DEBUG=true

# Solo si se usa una API propia en vez de Supabase.
# VITE_API_MODE=http
# VITE_API_URL=https://api.tuempresa.com
# VITE_API_TIMEOUT_MS=15000
